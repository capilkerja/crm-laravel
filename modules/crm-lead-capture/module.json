{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "crm-lead-capture",
  "display_name": "CRM Lead Capture",
  "description": "Leads inbox, capture channels, forms, surveys, QR codes, referrals, and source metadata.",
  "version": "1.0.0",
  "category": "capability",
  "provider": "Liberu\\CRM\\LeadCapture\\LeadCaptureServiceProvider",
  "requires": {"php": "^8.5", "laravel": "^13.0", "packages": {"liberusoftware/module-manager": "^1.0", "liberusoftware/module-crm-core": "^1.0"}, "capabilities": {"crm.core.records": "^1.0"}},
  "suggests": {"liberusoftware/module-crm-lead-capture-api": "^1.0", "liberusoftware/module-crm-lead-capture-filament": "^1.0", "liberusoftware/module-crm-lead-capture-livewire": "^1.0"},
  "capabilities": ["crm.lead-capture"],
  "default_enabled": true,
  "features": ["Leads inbox", "Manual/import/API capture", "Forms", "Surveys", "QR codes", "Chat", "Calls", "Advertisements", "Events", "Referrals", "Source metadata"]
